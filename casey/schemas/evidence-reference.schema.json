{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GlacierEQ/skills/casey/schemas/evidence-reference.schema.json",
  "title": "Private Evidence Reference Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "case_id", "source_type", "source_locator", "integrity", "authentication_status", "anchors"],
  "properties": {
    "evidence_id": {"type": "string", "pattern": "^EVID-[A-Z0-9][A-Z0-9-]{2,63}$"},
    "case_id": {"type": "string", "minLength": 3},
    "source_type": {
      "enum": ["court_record", "original_file", "email", "message", "audio", "video", "photo", "agency_record", "business_record", "other"]
    },
    "source_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "opaque_id"],
      "properties": {
        "system": {"type": "string", "minLength": 2},
        "opaque_id": {"type": "string", "minLength": 3},
        "version": {"type": "string"},
        "retrieved_at": {"type": "string", "format": "date-time"}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value", "computed_before_transformation"],
      "properties": {
        "algorithm": {"enum": ["sha256", "sha512"]},
        "value": {"type": "string", "pattern": "^[a-fA-F0-9]{64}(?:[a-fA-F0-9]{64})?$"},
        "computed_before_transformation": {"const": true}
      }
    },
    "authentication_status": {
      "enum": ["unknown", "verification_required", "authenticated", "self_authenticating", "disputed"]
    },
    "derivative_of": {"type": ["string", "null"]},
    "anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["anchor_id", "kind"],
        "properties": {
          "anchor_id": {"type": "string", "minLength": 3},
          "kind": {"enum": ["page", "line", "timecode", "frame", "record", "metadata"]},
          "page": {"type": "integer", "minimum": 1},
          "line_start": {"type": "integer", "minimum": 1},
          "line_end": {"type": "integer", "minimum": 1},
          "timecode_start": {"type": "string"},
          "timecode_end": {"type": "string"},
          "frame_start": {"type": "integer", "minimum": 0},
          "frame_end": {"type": "integer", "minimum": 0},
          "record_key": {"type": "string"},
          "content_digest": {"type": "string"}
        }
      }
    },
    "quality_warnings": {"type": "array", "items": {"type": "string"}, "default": []},
    "confidentiality": {"enum": ["public", "confidential", "privileged", "sealed"]}
  }
}
