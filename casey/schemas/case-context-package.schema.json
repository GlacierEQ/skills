{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GlacierEQ/skills/casey/schemas/case-context-package.schema.json",
  "title": "Private Case Context Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["package_id", "case_id", "procedural_track", "domain", "authorized_skills", "source_ids", "classification_policy", "case_isolation"],
  "properties": {
    "package_id": { "type": "string", "pattern": "^CTX-[A-Z0-9-]+$" },
    "case_id": { "type": "string", "minLength": 3 },
    "procedural_track": { "type": "string", "minLength": 3 },
    "domain": { "type": "string", "minLength": 2 },
    "authorized_skills": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^casey\\.[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "source_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "classification_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_classes", "court_facing_requires_provenance"],
      "properties": {
        "fact_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["established_record_fact", "authenticated_evidence", "party_allegation", "disputed_fact", "inference", "verification_target", "strategic_recommendation", "generated_summary"] }
        },
        "court_facing_requires_provenance": { "const": true }
      }
    },
    "case_isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cross_case_merge_allowed", "authorized_cross_references", "prohibited_case_ids"],
      "properties": {
        "cross_case_merge_allowed": { "const": false },
        "authorized_cross_references": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3 }
        },
        "prohibited_case_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3 }
        }
      }
    },
    "expires_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
