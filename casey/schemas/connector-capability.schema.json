{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GlacierEQ/skills/casey/schemas/connector-capability.schema.json",
  "title": "Private Connector Capability Injection Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["capability_id", "connector_id", "domain_owner", "trust", "allowed_operations", "canonical_data_types", "prohibited_data_types", "approval_required_for", "audit_log", "failure_policy"],
  "properties": {
    "capability_id": {"type": "string", "pattern": "^CAP-[A-Z0-9][A-Z0-9-]{2,63}$"},
    "connector_id": {"type": "string", "minLength": 2},
    "domain_owner": {"type": "string", "minLength": 2},
    "trust": {"enum": ["safe", "external", "system", "untrusted"]},
    "allowed_operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["read", "create", "update", "delete", "execute", "admin"]}
    },
    "read_scope": {"type": "array", "items": {"type": "string"}, "default": []},
    "write_scope": {"type": "array", "items": {"type": "string"}, "default": []},
    "canonical_data_types": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "prohibited_data_types": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "approval_required_for": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["create", "update", "delete", "execute", "admin", "fallback_write"]}
    },
    "audit_log": {
      "type": "object",
      "additionalProperties": false,
      "required": ["destination", "append_only"],
      "properties": {
        "destination": {"type": "string", "minLength": 3},
        "append_only": {"const": true}
      }
    },
    "failure_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["on_unavailable", "silent_fallback_allowed"],
      "properties": {
        "on_unavailable": {"enum": ["fail_closed", "queue", "read_only", "approved_fallback"]},
        "silent_fallback_allowed": {"const": false},
        "approved_fallback_capability_id": {"type": ["string", "null"]}
      }
    },
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "configuration_fingerprint": {"type": "string", "minLength": 8}
  }
}
