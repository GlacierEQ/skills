{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GlacierEQ/skills/casey/schemas/authorized-write-policy.schema.json",
  "title": "Private Authorized Write Policy Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_id", "default_deny", "rules", "prohibited_operations", "emergency_disable"],
  "properties": {
    "policy_id": {"type": "string", "pattern": "^WRITE-[A-Z0-9][A-Z0-9-]{2,63}$"},
    "default_deny": {"const": true},
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "capability_id", "target_pattern", "operations", "data_types", "approval", "append_only", "idempotency_required", "destructive_operations_allowed"],
        "properties": {
          "rule_id": {"type": "string", "minLength": 3},
          "capability_id": {"type": "string", "pattern": "^CAP-[A-Z0-9][A-Z0-9-]{2,63}$"},
          "target_pattern": {"type": "string", "minLength": 1},
          "operations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["create", "update", "delete", "execute", "admin"]}
          },
          "data_types": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "approval": {"enum": ["none", "human", "dual_control"]},
          "append_only": {"type": "boolean"},
          "idempotency_required": {"type": "boolean"},
          "destructive_operations_allowed": {"type": "boolean"},
          "max_batch_size": {"type": "integer", "minimum": 1},
          "expires_at": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    },
    "prohibited_operations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["overwrite_original_evidence", "silent_fallback_write", "unlogged_delete", "credential_export", "cross_case_write"]}
    },
    "emergency_disable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "mechanism", "fail_mode"],
      "properties": {
        "enabled": {"const": true},
        "mechanism": {"type": "string", "minLength": 3},
        "fail_mode": {"const": "fail_closed"}
      }
    }
  }
}
